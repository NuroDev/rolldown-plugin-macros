{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    ".wrangler/",
    "bun.lock",
    "dist/**/*",
    "node_modules/**/*"
  ],
  "jsxSingleQuote": true,
  "printWidth": 90,
  "semi": true,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["~/*"]
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva"]
  },
  "tabWidth": 4,
  "trailingComma": "all",
  "useTabs": true
}
