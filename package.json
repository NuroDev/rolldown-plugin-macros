{
	"name": "rolldown-plugin-macros",
	"version": "0.0.1",
	"description": "Rolldown plugin for Bun-compatible build macros using import attributes",
	"keywords": [
		"build-macros",
		"bun-macros",
		"import-attributes",
		"macros",
		"plugin",
		"rolldown"
	],
	"license": "MIT",
	"author": "Ben",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"rolldown": "^1.0.0-rc.14",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2",
		"vitest": "^4.1.3"
	},
	"peerDependencies": {
		"rolldown": ">=1.0.0-rc.14"
	}
}
